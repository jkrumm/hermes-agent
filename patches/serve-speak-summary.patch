+_SPEAK_SUMMARY = object()  # text_q sentinel: "speak a summary of the held text"
+
+
+def _speak_summary_min_chars(streamer) -> int:
+    """``voice.speak_summary_min_chars``: replies at least this long are spoken as a
+    one-sentence summary instead of read out in full (0 = off, the default).
+
+    Only the OpenAI-compatible streamer can do it — the audio-gateway behind
+    it owns the summarising LLM via its non-standard ``summarize`` request
+    field; every other provider keeps full speech.
+    """
+    from tools.tts_streaming import OpenAIStreamer
+
+    if not isinstance(streamer, OpenAIStreamer):
+        return 0
+    try:
+        from hermes_cli.config import load_config
+
+        raw = (load_config().get("voice") or {}).get("speak_summary_min_chars", 0)
+        return max(0, int(raw or 0))
+    except Exception:
+        return 0
+
+
+def _stream_speech_summary(streamer, text: str):
+    """Yield PCM for a spoken summary of *text* — one gateway call with
+    ``summarize: true``, same wire as ``OpenAIStreamer.stream`` otherwise."""
+    from openai import OpenAI
+    from tools.tts_streaming import get_env_value, resolve_openai_audio_api_key
+
+    section = streamer.section
+    client = OpenAI(
+        api_key=(section.get("api_key") or resolve_openai_audio_api_key()),
+        base_url=(section.get("base_url") or get_env_value("OPENAI_BASE_URL") or None),
+    )
+    with client.audio.speech.with_streaming_response.create(
+        model=section.get("model", "gpt-4o-mini-tts"),
+        voice=section.get("voice", "alloy"),
+        input=text,
+        response_format="pcm",
+        extra_body={"summarize": True},
+    ) as response:
+        yield from response.iter_bytes()
+
+
