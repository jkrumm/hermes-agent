+# LOCAL MODIFICATION (patches/transport-iu-reasoning-effort.patch)
+# Kept in sync by hand with the same literal in hermes_cli/runtime_provider.py
+# (patches/runtime-provider-iu-responses-api.patch), which routes this host's
+# OpenAI leg onto the Responses API, and with the identical host+path predicate
+# in agent/auxiliary_client.py (``_is_iu_openai_leg``) and run_agent.py
+# (``_is_iu_unified_endpoint_openai_leg``). All local patches over upstream, so
+# there is no shared module to hang one constant off — keep the three in sync.
+_IU_UNIFIED_ENDPOINT_HOST = "unified-endpoint-main.app.iu-it.org"
+# Efforts the IU gateway accepts, per model family. Probed against the live
+# endpoint 2026-08-14 (gpt-5.x / Anthropic) and 2026-09-13 (deepseek / glm):
+#   gpt-5.6-luna + 'max'  -> "Unsupported value: 'reasoning_effort' does not
+#                            support 'max' with this model. Supported values
+#                            are: 'none', 'low', 'medium', 'high', 'xhigh'."
+#   claude-sonnet-4-6-eu + 'xhigh' -> "effort='xhigh' is not supported by this
+#                            model" (LiteLLM -> Anthropic); none/low/medium/high OK.
+#   deepseek-v4.1-flash: accepts low/high/xhigh/max, and — unlike gpt-5.x —
+#                            accepts function tools and an effort in the same
+#                            /chat/completions request (no 400 seen).
+#   glm-5.3-flash: 'medium' is refused on this leg; low/high/max OK.
+#   gpt-6-luna (2026-09-23): same none..xhigh ladder as gpt-5.x ('max' refused),
+#                            same tools+effort refusal — but, unlike gpt-5.6-luna,
+#                            it also refuses tools with the key *omitted* (its
+#                            default effort isn't 'none'); only an explicit
+#                            'none' passes alongside tools.
+_IU_EFFORTS_BY_FAMILY: dict[str, tuple[str, ...]] = {
+    "gpt-5": ("none", "low", "medium", "high", "xhigh"),
+    "gpt-6": ("none", "low", "medium", "high", "xhigh"),
+    "anthropic": ("none", "low", "medium", "high"),
+    "deepseek": ("low", "high", "xhigh", "max"),
+    "glm": ("low", "high", "max"),
+}
+# Deny-by-default: only these families are probed (2026-09-13) to accept function tools AND
+# a top-level reasoning_effort in the same /chat/completions request. Everything else — gpt-5.x
+# included, and any model id this endpoint hasn't been probed against — has the effort stripped
+# whenever tools are present, never the other way around.
+_IU_TOOLS_EFFORT_ALLOWED_FAMILIES = frozenset({"anthropic", "deepseek", "glm"})
+# Families that refuse function tools unless the effort is explicitly 'none' — dropping the
+# key is not enough for them (probed 2026-09-23, gpt-6-luna).
+_IU_TOOLS_EFFORT_NONE_FAMILIES = frozenset({"gpt-6"})
+
+
+def _iu_model_family(model: str) -> str:
+    """One of ``gpt-5``/``gpt-6``/``anthropic``/``deepseek``/``glm``, or ``""`` for a model id this
+    gateway hasn't been probed against — callers must not guess a ladder or a tools+effort
+    allowance for the unrecognized case."""
+    m = (model or "").lower()
+    if "claude" in m:
+        return "anthropic"
+    if "glm" in m:
+        return "glm"
+    if "deepseek" in m:
+        return "deepseek"
+    if m.startswith("gpt-5"):
+        return "gpt-5"
+    if m.startswith("gpt-6"):
+        return "gpt-6"
+    return ""
+
+
+def _iu_effort_family(model: str) -> tuple[str, ...]:
+    """Allowed top-level ``reasoning_effort`` values for ``model`` on this gateway, or ``()``
+    for an unrecognized id — effort is omitted rather than guessed."""
+    return _IU_EFFORTS_BY_FAMILY.get(_iu_model_family(model), ())
+
+
+def _is_iu_openai_leg(base_url: Any) -> bool:
+    """True for the IU unified endpoint's OpenAI-compatible leg (``…/openai/v1``), exact
+    hostname + path — never containment, so a lookalike host
+    (``unified-endpoint-main.app.iu-it.org.example.test``) or the gateway's own
+    ``/anthropic`` leg don't match. Identical predicate to
+    ``agent.auxiliary_client._is_iu_openai_leg`` and
+    ``run_agent.AIAgent._is_iu_unified_endpoint_openai_leg`` — keep all three in sync."""
+    try:
+        parsed = urlparse(str(base_url or "").strip())
+    except Exception:
+        return False
+    return ((parsed.hostname or "").lower() == _IU_UNIFIED_ENDPOINT_HOST
+             and (parsed.path or "").rstrip("/").endswith("/openai/v1"))
+
+
+def _apply_iu_reasoning_effort(
+    api_kwargs: dict[str, Any], model: str, params: dict[str, Any],
+) -> dict[str, Any]:
+    """Reconcile top-level ``reasoning_effort`` with what the IU gateway takes.
+
+    Upstream's ``CustomProfile`` already puts ``reasoning_effort`` on the wire
+    top-level for custom providers — the correct spelling here, since this
+    gateway (Azure OpenAI + LiteLLM behind one OpenAI-compatible URL) rejects
+    the ``extra_body {"reasoning": ...}`` form with ``Unknown parameter:
+    'reasoning'``. What upstream cannot know is which values each leg of the
+    gateway accepts, and it emits the configured value unconditionally.
+
+    Two live-verified refusals this reconciles (2026-08-14, gpt-5.x / Anthropic):
+
+    * The Azure-backed gpt-5.x models refuse *any* effort as soon as the
+      request carries function tools — "Function tools with reasoning_effort
+      are not supported for gpt-5.6-luna in /v1/chat/completions. To use
+      function tools, use /v1/responses or set reasoning_effort to 'none'".
+      Hermes always sends tools, so a configured effort 400s **every** turn
+      and burns the retry budget into the fallback model. The key is dropped
+      instead; ``model.api_mode: codex_responses`` is the way to actually
+      raise a GPT's effort on this endpoint.
+    * The Anthropic leg refuses ``xhigh``/``max`` ("effort='xhigh' is not
+      supported by this model") but takes tools and effort together happily.
+      That one is clamped down rather than dropped, so a failover never turns
+      a config value into a 400.
+
+    **Tools+effort is deny-by-default, not gpt-5-only** (2026-09-13): only
+    ``anthropic``/``deepseek``/``glm`` (``_IU_TOOLS_EFFORT_ALLOWED_FAMILIES``) are
+    probed to accept both together — deepseek-v4.1-flash (the brain) accepts them,
+    so its ``reasoning_effort`` reaches the wire on every turn, but an
+    **unrecognized** model id gets the same strip as gpt-5.x, never the benefit of
+    the doubt. ``gpt-6`` (``_IU_TOOLS_EFFORT_NONE_FAMILIES``) gets an explicit
+    ``none`` instead of a strip — it refuses tools with the key omitted, too.
+
+    Anything outside this host is left exactly as upstream built it.
+    """
+    if not _is_iu_openai_leg(params.get("base_url")):
+        return api_kwargs
+    family = _iu_model_family(model)
+    if api_kwargs.get("tools") and family in _IU_TOOLS_EFFORT_NONE_FAMILIES:
+        api_kwargs["reasoning_effort"] = "none"
+        return api_kwargs
+    if api_kwargs.get("tools") and family not in _IU_TOOLS_EFFORT_ALLOWED_FAMILIES:
+        api_kwargs.pop("reasoning_effort", None)
+        return api_kwargs
+    effort = api_kwargs.get("reasoning_effort")
+    if effort is None:
+        cfg = _reasoning_config_for_model(model, params.get("reasoning_config"))
+        if not isinstance(cfg, dict):
+            return api_kwargs
+        effort = "none" if cfg.get("enabled") is False else cfg.get("effort")
+    effort = str(effort or "").strip().lower()
+    # () for an unrecognized model family — the clamp below finds no candidate at or
+    # below the request and omits the key, rather than guessing a value.
+    allowed = _iu_effort_family(model)
+    if effort not in allowed:
+        # Clamp to the strongest supported level at or below the request.
+        ladder = ("none", "low", "medium", "high", "xhigh", "max")
+        if effort not in ladder:
+            return api_kwargs
+        effort = next(
+            (e for e in reversed(allowed) if ladder.index(e) <= ladder.index(effort)),
+            None,
+        )
+        if effort is None:
+            api_kwargs.pop("reasoning_effort", None)
+            return api_kwargs
+    api_kwargs["reasoning_effort"] = effort
+    return api_kwargs
+
+
