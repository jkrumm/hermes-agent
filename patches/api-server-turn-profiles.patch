         "credential_pool": runtime.get("credential_pool")}
 
 
+def _match_turn_profile(user_config: Any, ephemeral_system_prompt: Optional[str]) -> dict[str, Any]:
+    """LOCAL MODIFICATION (patches/api-server-turn-profiles.patch): the first
+    ``api_server_turn_profiles`` entry of config.yaml whose ``match`` substring occurs in the
+    caller's system_message, else {}. A profile carries ``skills`` (preloaded into the turn's
+    system prompt, so call 1 does work instead of a skill_view round trip), ``replace`` (phrases of
+    the caller's message to rewrite) and ``reasoning_effort`` (applied when the request sets none).
+    The source label of a session is not carried to the agent; the system_message is the only
+    per-turn marker a client such as Iris controls."""
+    profiles = user_config.get("api_server_turn_profiles") if isinstance(user_config, dict) else None
+    if not ephemeral_system_prompt or not isinstance(profiles, list):
+        return {}
+    for profile in profiles:
+        marker = profile.get("match") if isinstance(profile, dict) else None
+        if isinstance(marker, str) and marker and marker in ephemeral_system_prompt:
+            return profile
+    return {}
+
+
+def _turn_profile_prompt(profile: dict[str, Any], ephemeral_system_prompt: Optional[str], session_id: Optional[str]) -> Optional[str]:
+    """LOCAL MODIFICATION: the profile's preloaded skill blocks followed by the caller's system_message.
+    The skill text is a pure function of the skill files (never of the session), so every turn of every
+    session carries the same bytes and the prompt cache holds. A missing skill is logged and skipped."""
+    # `replace` rewrites phrases of the caller's message (the same bytes every turn): Iris's message still says
+    # "Load skill_view('iris')", which makes the model fetch the skill it already carries in the prompt.
+    for old, new in (profile.get("replace") or {}).items():
+        if isinstance(old, str) and isinstance(new, str) and ephemeral_system_prompt:
+            ephemeral_system_prompt = ephemeral_system_prompt.replace(old, new)
+    names = [s for s in (profile.get("skills") or []) if isinstance(s, str) and s.strip()]
+    if not names:
+        return ephemeral_system_prompt
+    from agent.skill_commands import build_preloaded_skills_prompt, format_missing_skills
+    skills_prompt, _loaded, missing = build_preloaded_skills_prompt(names, task_id=session_id)
+    if missing:
+        logger.warning("api_server turn profile: skipping %s", format_missing_skills(missing))
+    return f"{skills_prompt}\n\n{ephemeral_system_prompt}" if skills_prompt else ephemeral_system_prompt
+
+
+def _apply_turn_profile(settings: dict[str, Any], user_config: Any, session_id: Optional[str]) -> None:
+    """LOCAL MODIFICATION: apply the matching turn profile to an API admission's ``settings`` in place
+    (``ephemeral_system_prompt``, ``model_options.reasoning_effort``). Called once per admission, before
+    the settings are persisted, so a replayed admission carries the same bytes. A request that names its
+    own effort keeps it."""
+    profile = _match_turn_profile(user_config, settings.get("ephemeral_system_prompt"))
+    if not profile:
+        return
+    settings["ephemeral_system_prompt"] = _turn_profile_prompt(profile, settings.get("ephemeral_system_prompt"), session_id)
+    effort = profile.get("reasoning_effort")
+    options = settings.get("model_options")
+    if effort and not (isinstance(options, dict) and ("reasoning_effort" in options or "reasoning" in options)):
+        settings["model_options"] = {**(options if isinstance(options, dict) else {}), "reasoning_effort": effort}
+
+
 def _request_agent_overrides(
