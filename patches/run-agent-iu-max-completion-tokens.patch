+    # LOCAL MODIFICATION (patches/run-agent-iu-max-completion-tokens.patch)
+    def _is_iu_unified_endpoint_openai_leg(self, base_url: str = None) -> bool:
+        """True for the IU unified endpoint's OpenAI-compatible leg (``provider: custom``,
+        ``…/openai/v1``). That leg's 65536 output-token floor is rejected as ``max_tokens``
+        regardless of which model is behind it — ``model_forces_max_completion_tokens``
+        only recognizes OpenAI model-id prefixes (gpt-4o/4.1/5, o1/o3/o4), so a non-OpenAI
+        id served through this custom provider (deepseek-v4.1-flash) fell through to the
+        rejected key. Exact hostname + ``/openai/v1`` path, never containment — identical
+        predicate to ``agent.auxiliary_client._is_iu_openai_leg`` and
+        ``agent.transports.chat_completions._is_iu_openai_leg`` (the three IU-leg patches
+        must not drift to different rigor); the gateway's ``/anthropic`` leg must stay
+        untouched."""
+        url = str(base_url) if base_url is not None else (getattr(self, "_base_url_lower", "") or "")
+        try:
+            parsed = urlparse(str(url or "").strip())
+        except Exception:
+            return False
+        return ((parsed.hostname or "").lower() == "unified-endpoint-main.app.iu-it.org"
+                 and (parsed.path or "").rstrip("/").endswith("/openai/v1"))
