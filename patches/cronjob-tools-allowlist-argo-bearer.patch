+    # Local patch (Hermes-agent local mod, see ~/SourceRoot/hermes-agent/patches/):
+    # argo.jkrumm.com, karakeep.jkrumm.com, research.jkrumm.com, hyperdx.jkrumm.com
+    # and audio-gateway.jkrumm.com are this deployment's trusted personal APIs.
+    # Bundled skills curl them with `Authorization: Bearer $HOMELAB_API_KEY` /
+    # `$KARAKEEP_API_KEY` / `$RESEARCH_API_KEY` / `$HYPERDX_AGENT_ACCESS_KEY` /
+    # `hermes` (the podcast skill's caller label, not a secret) — GET and POST
+    # (including multi-line shell continuations with embedded JSON). The
+    # upstream `exfil_curl_*` patterns flag these because they're
+    # indistinguishable from real exfil at the regex level. Strategy: replace
+    # any bash code fence (``` ... ```) whose only http(s) host(s) are
+    # allowlisted with a sanitized placeholder, then also strip single-line
+    # allowlisted curls outside fences. Real exfil to a non-allowlisted host
+    # stays flagged: it lives either outside a clean fence or on a line
+    # carrying a foreign host.
+    _trusted_api_host = r'(?:argo|karakeep|research|hyperdx|audio-gateway)\.jkrumm\.com'
+    _trusted_api_suffixes = ('argo.jkrumm.com', 'karakeep.jkrumm.com', 'research.jkrumm.com', 'hyperdx.jkrumm.com', 'audio-gateway.jkrumm.com')
+
+    def _host_is_trusted(host: str) -> bool:
+        # Exact match or a genuine subdomain — NOT a mere suffix match, which would let
+        # `evilargo.jkrumm.com` pass as trusted because it ends with `argo.jkrumm.com`.
+        h = host.lower()
+        return any(h == suffix or h.endswith('.' + suffix) for suffix in _trusted_api_suffixes)
+
+    def _all_hosts_trusted(body: str) -> bool:
+        other_hosts = re.findall(r'https?://([^\s"\'`/]+)', body, re.IGNORECASE)
+        return all(_host_is_trusted(h) for h in other_hosts)
+
+    def _sanitize_trusted_api_fence(match):
+        body = match.group(0)
+        if not re.search(rf'https?://{_trusted_api_host}\b', body, re.IGNORECASE):
+            return body
+        # Only sanitize fences where EVERY http(s) host is allowlisted — if any
+        # foreign host appears alongside, leave the fence intact so the
+        # downstream exfil patterns can flag a co-located evil curl.
+        if not _all_hosts_trusted(body):
+            return body
+        return '```\n# [trusted API bash fence — sanitized by local allowlist]\n```'
+
+    result = re.sub(
