+        if not _all_hosts_trusted(line):
+            return line
+        return '# [trusted API curl — sanitized by local allowlist]'
+
+    result = re.sub(
+        rf'^.*\bcurl\b[^\n]*\bhttps?://{_trusted_api_host}\b[^\n]*$',
+        _sanitize_trusted_api_line,
+        result,
+        flags=re.IGNORECASE | re.MULTILINE,
+    )
