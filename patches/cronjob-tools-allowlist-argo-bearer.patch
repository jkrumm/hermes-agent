+def _strip_cron_safe_constructs(prompt: str) -> str:
+    """Scrub this deployment's trusted-API curls so they don't trip the auth-header exfil rule.
+
+    LOCAL MODIFICATION (patches/cronjob-tools-allowlist-argo-bearer.patch). Upstream no longer
+    exempts any curl (its remedy is `gh api` / a --script job), so this carries only our own
+    allowlist: argo / karakeep / hyperdx .jkrumm.com bearer curls and the agent-workflows audio
+    door (127.0.0.1:7792, exact authority). Bundled skills curl them with
+    `Authorization: Bearer $HOMELAB_API_KEY` / `$KARAKEEP_API_KEY` / `$HYPERDX_AGENT_ACCESS_KEY`
+    / `$AUDIO_DOOR_TOKEN`, GET and POST, including multi-line shell continuations with embedded
+    JSON; at the regex level that is indistinguishable from exfil. Strategy: replace any bash
+    code fence whose http(s) hosts are ALL allowlisted with a placeholder, then strip single-line
+    allowlisted curls outside fences. Real exfil to a non-allowlisted host stays flagged: it
+    lives either outside a clean fence or on a line carrying a foreign host.
+    """
+    _trusted_api_host = r'(?:(?:argo|karakeep|hyperdx)\.jkrumm\.com|127\.0\.0\.1:7792)'
+    _trusted_api_suffixes = ('argo.jkrumm.com', 'karakeep.jkrumm.com', 'hyperdx.jkrumm.com')
+    _trusted_api_exact = ('127.0.0.1:7792',)  # loopback door: exact authority only, never a subdomain
+
+    def _host_is_trusted(host: str) -> bool:
+        # Exact match or a genuine subdomain — NOT a mere suffix match, which would let
+        # `evilargo.jkrumm.com` pass as trusted because it ends with `argo.jkrumm.com`.
+        h = host.lower()
+        return h in _trusted_api_exact or any(h == suffix or h.endswith('.' + suffix) for suffix in _trusted_api_suffixes)
+
+    def _all_hosts_trusted(body: str) -> bool:
+        other_hosts = re.findall(r'https?://([^\s"\'`/]+)', body, re.IGNORECASE)
+        return all(_host_is_trusted(h) for h in other_hosts)
+
+    def _sanitize_trusted_api_fence(match):
+        body = match.group(0)
+        if not re.search(rf'https?://{_trusted_api_host}\b', body, re.IGNORECASE):
+            return body
+        # Only sanitize fences where EVERY http(s) host is allowlisted — if any
+        # foreign host appears alongside, leave the fence intact so the
+        # downstream exfil patterns can flag a co-located evil curl.
+        if not _all_hosts_trusted(body):
+            return body
+        return '```\n# [trusted API bash fence — sanitized by local allowlist]\n```'
+
+    result = re.sub(
+        r'```[a-zA-Z0-9_-]*\n[\s\S]*?\n```',
+        _sanitize_trusted_api_fence,
+        prompt,
+    )
+
+    def _sanitize_trusted_api_line(match):
+        line = match.group(0)
+        # Same all-hosts-must-be-trusted check as the fence handler — a foreign host
+        # co-located on the same line must not be hidden behind the trusted placeholder.
+        if not _all_hosts_trusted(line):
+            return line
+        return '# [trusted API curl — sanitized by local allowlist]'
+
+    return re.sub(
+        rf'^.*\bcurl\b[^\n]*\bhttps?://{_trusted_api_host}\b[^\n]*$',
+        _sanitize_trusted_api_line,
+        result,
+        flags=re.IGNORECASE | re.MULTILINE,
+    )
+
+
