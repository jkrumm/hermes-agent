+# LOCAL MODIFICATION (patches/auxiliary-client-iu-openai-leg-quirks.patch)
+_IU_UNIFIED_ENDPOINT_HOST = "unified-endpoint-main.app.iu-it.org"
+
+
+def _is_iu_openai_leg(base_url: Optional[str]) -> bool:
+    """True for the IU unified endpoint's OpenAI-compatible leg (``…/openai/v1``), exact
+    hostname + path — never containment, so a lookalike host or the gateway's own
+    ``/anthropic`` leg don't match. Identical predicate to
+    ``run_agent.AIAgent._is_iu_unified_endpoint_openai_leg`` and the host check in
+    ``agent.transports.chat_completions._apply_iu_reasoning_effort`` — keep all three in
+    sync; they must not drift to different rigor."""
+    try:
+        parsed = urlparse(str(base_url or "").strip())
+    except Exception:
+        return False
+    return ((parsed.hostname or "").lower() == _IU_UNIFIED_ENDPOINT_HOST
+             and (parsed.path or "").rstrip("/").endswith("/openai/v1"))
+
+
+def _is_gpt5_on_iu_openai_leg(model: Optional[str], base_url: Optional[str]) -> bool:
+    """True when ``model`` is a gpt-5.x id being called on the IU unified endpoint's
+    OpenAI-compatible leg — that leg 503s on any explicit, non-default ``temperature``
+    for gpt-5.x (title_generation hardcodes 0.3 at the call site). Mirrors the
+    tools+reasoning_effort strip in ``patches/transport-iu-reasoning-effort.patch``."""
+    return _bare_model(model).startswith("gpt-5") and _is_iu_openai_leg(base_url)
