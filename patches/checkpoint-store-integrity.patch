+def _log_stderr(stderr: str, max_lines: int = 1, max_chars: int = 400) -> str:
+    """Cap a git stderr for the log line (LOCAL MODIFICATION — patches/checkpoint-store-integrity.patch).
+
+    The FIRST line is the signature — Warden's log poller derives a `hermes_log:*` external_id from
+    it — so it is kept verbatim; the remainder is summarized.  Observed live: an `add -A` failure
+    whose true cause was `'cpexp3.sgahXS/' hat keinen Commit ausgecheckt` on line 16 was filed as
+    "Füge eingebettetes Repository hinzu: cpexp.znuOaZ" (an advice warning on line 1) and sent a
+    dispatch after an innocent directory.  The full stderr still reaches the caller unchanged."""
+    lines = stderr.splitlines()
+    if len(lines) <= max_lines and len(stderr) <= max_chars:
+        return stderr
+    head = lines[0][:max_chars] if lines else ""
+    return f"{head} … [+{max(0, len(lines) - max_lines)} more line(s), {len(stderr)} chars total]"
+
