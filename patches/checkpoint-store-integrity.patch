+def _log_stderr(stderr: str, max_lines: int = 1, max_chars: int = 400) -> str:
+    """Cap a git stderr for the log line (LOCAL MODIFICATION — patches/checkpoint-store-integrity.patch).
+
+    The FIRST line is the signature — Warden's log poller derives a `hermes_log:*` external_id from
+    it — so it is kept verbatim; the remainder is summarized.  Observed live: an `add -A` failure
+    whose true cause was `'cpexp3.sgahXS/' hat keinen Commit ausgecheckt` on line 16 was filed as
+    "Füge eingebettetes Repository hinzu: cpexp.znuOaZ" (an advice warning on line 1) and sent a
+    dispatch after an innocent directory.  The full stderr still reaches the caller unchanged."""
+    lines = stderr.splitlines()
+    if len(lines) <= max_lines and len(stderr) <= max_chars:
+        return stderr
+    head = lines[0][:max_chars] if lines else ""
+    return f"{head} … [+{max(0, len(lines) - max_lines)} more line(s), {len(stderr)} chars total]"
+
+
+def _stage_failure_cause(stderr: str) -> str:
+    """The line in an ``add -A`` stderr that actually explains the failure.
+
+    LOCAL MODIFICATION (patches/checkpoint-store-integrity.patch).  ``git add -A`` reports one
+    failure and a pile of advice, and the advice can come FIRST — the live 13:59:12 failure opened
+    with ``Warnung: Füge eingebettetes Repository hinzu: cpexp.znuOaZ`` (a nested repo added as a
+    gitlink, entirely normal) while the cause was ``Fehler: 'cpexp3.sgahXS/' hat keinen Commit
+    ausgecheckt`` sixteen lines later.  The dispatch that followed chased the innocent directory.
+    So the retry's own log line names the cause, not the first line: the last line matching git's
+    error/fatal markers, falling back to the first line when nothing matches."""
+    lines = [line for line in stderr.splitlines() if line.strip()]
+    if not lines:
+        return ""
+    markers = ("fatal:", "error:", "Schwerwiegend:", "Fehler:")
+    for line in reversed(lines):
+        if any(line.startswith(m) for m in markers):
+            return line
+    return lines[0]
+
+
