+def _index_gitlinks(store: Path, working_dir: str, index_file: Path) -> list[str]:
+    """Paths recorded as mode-160000 gitlinks in the per-project index (NUL-separated, so a
+    path with a newline survives).  Empty on any failure — the caller then has nothing to drop."""
+    _, out, _ = _run_git(
+        ["ls-files", "--stage", "-z"], store, working_dir, index_file=index_file,
+    )
+    return [rec.split("\t", 1)[1] for rec in out.split("\x00") if rec.startswith("160000") and "\t" in rec]
+
+
+def _gitlink_is_live(abs_dir: str, rel: str) -> bool:
+    """Whether the nested repo behind an index gitlink still resolves.  A ``.git`` FILE is a
+    submodule checkout and always counts as live; a ``.git`` directory must still carry HEAD
+    (com.apple.tmp_cleaner removes HEAD/config/refs and leaves objects+index behind, which is
+    what wedges ``add -A``).  Deliberately filesystem-only: any ``git -C <path>`` probe under
+    the store's GIT_DIR answers about the store, not the nested repo."""
+    dot_git = Path(abs_dir) / rel / ".git"
+    return dot_git.is_file() or (dot_git / "HEAD").exists()
+
+
+def _drop_dead_gitlinks(store: Path, working_dir: str, index_file: Path) -> list[str]:
+    """``update-index --force-remove`` every index gitlink whose nested repo no longer resolves.
+    Returns the paths dropped.  ``--force-remove`` is what makes this work: the gitlink is
+    already in the index, so neither ``info/exclude`` nor ``add -A --ignore-errors`` (still
+    rc=128) can clear it, and a plain ``rm --cached`` would try to stat the dead repo."""
+    abs_dir = str(_normalize_path(working_dir))
+    dropped = []
+    for rel in _index_gitlinks(store, working_dir, index_file):
+        if _gitlink_is_live(abs_dir, rel):
+            continue
+        ok, _, err = _run_git(
+            ["update-index", "--force-remove", rel], store, working_dir, index_file=index_file,
+        )
+        if ok:
+            dropped.append(rel)
+        else:
+            logger.warning("Could not drop dead gitlink %s in %s: %s", rel, abs_dir, err)
+    return dropped
+
+
+def _drop_ignored_tracked(store: Path, working_dir: str, index_file: Path) -> list[str]:
+    """``update-index --force-remove`` every tracked path the store's own ``info/exclude`` matches.
+
+    LOCAL MODIFICATION (patches/checkpoint-store-integrity.patch).  ``git add -A`` honours
+    ``info/exclude`` only for paths that are *not yet* in the index, and ``_take`` read-trees
+    the ref tip back in on every snapshot — so a path committed before a pattern was
+    added to ``DEFAULT_EXCLUDES`` stays tracked forever and keeps being staged.  That is exactly
+    what happened to ``claude-501/`` (Claude Code's scratch under ``/tmp``, 1920 paths / ~32 MB in
+    the ``/tmp`` ref): the pattern is new, the paths were already committed, and excluding them
+    changed nothing until they are dropped from the index.  The drop is committed by the snapshot
+    that follows, and because this runs after every read-tree it self-heals even if a ref tip
+    still carries them.
+
+    ``-X <file>`` rather than ``--exclude-standard`` on purpose: the latter would also apply the
+    *project's* ``.gitignore``, and a path a project deliberately ignores but the shadow store
+    already tracks is not this function's business."""
+    exclude_path = store / "info" / "exclude"
+    if not exclude_path.exists():
+        return []
+    ok, out, _ = _run_git(
+        ["ls-files", "--cached", "-i", "-z", "-X", str(exclude_path)],
+        store, working_dir, index_file=index_file,
+    )
+    if not ok:
+        return []
+    dropped = [rel for rel in out.split("\x00") if rel]
+    for i in range(0, len(dropped), 200):  # chunk: never overflow argv
+        _run_git(
+            ["update-index", "--force-remove", "--"] + dropped[i:i + 200],
+            store, working_dir, index_file=index_file, allowed_returncodes={128},
+        )
+    return dropped
+
+
+def _stage_all_with_gitlink_recovery(
+    store: Path, working_dir: str, index_file: Path,
+) -> tuple[bool, str, str]:
+    """``_stage_all``, then — only when git reports the nested-repo boundary itself is broken —
+    drop the dead gitlinks and retry once.  A stale gitlink is recorded when the nested repo was
+    healthy and survives the per-snapshot read-tree, so without this the
+    project's checkpoints fail forever with one ERROR line per attempt and nothing self-heals.
+    The retry is itself the fix: dropping the gitlink is a change vs the ref tip, so the snapshot
+    proceeds and ``write-tree`` commits a gitlink-free tree, which no later read-tree can
+    resurrect.  The stderr test is language-independent on purpose — git localizes it (observed
+    ``Schwerwiegend: 'x/.git' nicht als Git-Repository erkannt`` under this host's de_DE locale),
+    so matching the English sentence would silently never fire here.  The first attempt's failure
+    is expected and suppressed from the log; only the retry's outcome is reported.
+
+    LOCAL MODIFICATION (patches/checkpoint-store-integrity.patch): the retry is no longer gitlink-only.
+    ``git add -A`` walks the tree and then reads each entry, so a file that disappears in between
+    — Claude Code deleting its own scratch under ``/tmp`` while an episode ends, an agent worktree
+    being torn down — fails the whole add with ``unable to stat '<path>': No such file or
+    directory`` even though nothing is wrong with the store or the index.  Verified live: the
+    identical add succeeds on the immediate retry.  So one retry now covers both transient shapes;
+    a persistent failure (a commitless nested repo, an unreadable file) still fails the retry and
+    is reported once, from the retry's own stderr."""
+    ok, out, err = _stage_all(store, working_dir, index_file, allowed_returncodes={128})
+    if ok:
+        return ok, out, err
+    if ".git" in err:
+        dropped = _drop_dead_gitlinks(store, working_dir, index_file)
+        if dropped:
+            logger.info("Dropped %d dead gitlink(s) from the checkpoint index of %s: %s",
+                        len(dropped), working_dir, ", ".join(dropped))
+    # LOCAL MODIFICATION (patches/checkpoint-store-integrity.patch): name the cause, not the first
+    # line.  `add -A` puts advice before the error, and the first line is what a reader (and Warden's
+    # log poller) treats as the signature — live, that filed a dispatch against an innocent nested
+    # repo while the real cause sat sixteen lines down.
+    logger.info("Retrying checkpoint staging after a transient add failure in %s (cause: %s)",
+                working_dir, _stage_failure_cause(err))
+    return _stage_all(store, working_dir, index_file)
+
