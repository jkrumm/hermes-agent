+    ok, out, _ = _run_git(["ls-files", "--cached", "-i", "-z", "-X", str(exclude_path)],
+                          p.store, p.abs_dir, index_file=p.index_file)
+    if not ok:
+        return []
+    dropped = [rel for rel in out.split("\x00") if rel]
+    for i in range(0, len(dropped), 200):  # chunk: never overflow argv
+        _run_git(["update-index", "--force-remove", "--"] + dropped[i:i + 200],
+                 p.store, p.abs_dir, index_file=p.index_file, allowed_returncodes={128})
+    return dropped
