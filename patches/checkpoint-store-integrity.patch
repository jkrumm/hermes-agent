+def _drop_dead_gitlinks(p: _ProjectRefs) -> List[str]:
+    """``update-index --force-remove`` every index gitlink whose nested repo no longer resolves.
+    Returns the paths dropped.  ``--force-remove`` is what makes this work: the gitlink is
+    already in the index, so neither ``info/exclude`` nor ``add -A --ignore-errors`` (still
+    rc=128) can clear it, and a plain ``rm --cached`` would try to stat the dead repo."""
+    dropped = []
+    for rel in _index_gitlinks(p):
+        if _gitlink_is_live(p.abs_dir, rel):
+            continue
+        ok, _, err = _run_git(["update-index", "--force-remove", rel], p.store, p.abs_dir, index_file=p.index_file)
+        if ok:
+            dropped.append(rel)
+        else:
+            logger.warning("Could not drop dead gitlink %s in %s: %s", rel, p.abs_dir, err)
+    return dropped
