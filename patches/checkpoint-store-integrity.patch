+def _write_store_excludes(store: Path) -> None:
+    """Write the store's ``info/exclude`` from ``DEFAULT_EXCLUDES`` when it has moved on.
+
+    LOCAL MODIFICATION (patches/checkpoint-store-integrity.patch): the file used to be written once, at
+    store init, so a store created before a pattern was added to ``DEFAULT_EXCLUDES`` never picked
+    it up — the live store still had the pre-``claude-501/`` list.  The file is ours alone (the
+    store is a private bare repo), so rewriting it loses nothing, and the read-then-compare keeps
+    the common case to one small read per snapshot."""
+    exclude_path = store / "info" / "exclude"
+    desired = "\n".join(DEFAULT_EXCLUDES) + "\n"
+    try:
+        if exclude_path.exists() and exclude_path.read_text(encoding="utf-8") == desired:
+            return
+        exclude_path.parent.mkdir(parents=True, exist_ok=True)
+        exclude_path.write_text(desired, encoding="utf-8")
+        logger.debug("Wrote checkpoint store exclude file at %s", exclude_path)
+    except OSError as exc:
+        logger.warning("Could not write checkpoint store exclude file: %s", exc)
+
