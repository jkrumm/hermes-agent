<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.hermes-serve</string>
  <!-- `hermes serve` — the JSON-RPC/WebSocket backend Hermes Desktop connects to,
       on loopback :9119 behind the Caddy door. A second long-lived process against
       one ~/.hermes next to the Slack gateway; upstream expects serve and gateway to
       coexist (separate commands, separate ports). -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/SourceRoot/hermes-agent/scripts/hermes-serve-launch.sh</string>
  </array>
  <!-- A long-lived server, so KeepAlive, with a 30s throttle because the launcher's
       exit 78 (auth refs unresolved) is a configuration state a human has to clear,
       not a transient worth spinning on. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>RunAtLoad</key><true/>
  <key>WorkingDirectory</key><string>__HOME__/.hermes/hermes-agent</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/hermes-serve.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/hermes-serve.err</string>
</dict>
</plist>
