<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.hermes-triage</string>
  <!-- The alert triage act-loop (scripts/triage.py, see docs/triage.md). Turns
       deduplicated watchdog.db events into one durable, updated-in-place Slack
       card per problem and, once eligible, a real sideclaw investigation. No
       LLM call anywhere in the file.

       This is a LaunchAgent, not the `hermes cron create --script` registration
       docs/triage.md originally proposed, because the loop that notices Hermes
       is broken cannot itself depend on the gateway process being up to run it
       — an adversarial review found four open watchdog.db hermes_log rows that
       are exactly that failure, one open 11 days with reminder_count 5 and no
       action ever taken, because the only delivery path a gateway-scheduled job
       has is the same Slack connection those rows say is down. Slack delivery
       here is a plain HTTP client (chat.postMessage/chat.update via
       resolve_slack_token(), never the gateway's live AsyncApp), so this keeps
       working with the gateway fully stopped — the same reasoning as the
       liveness/backup agents in this file. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.hermes/hermes-agent/venv/bin/python3</string>
    <string>__HOME__/SourceRoot/hermes-agent/scripts/triage.py</string>
    <string>--run</string>
  </array>
  <!-- Every 10 minutes, matching the interval docs/triage.md always specified
       for this loop. RunAtLoad closes the gap after a reboot the same way the
       liveness agent does — the script is idempotent (card_hash short-circuits
       an unchanged render), so firing it early on `make setup` is harmless. -->
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <!-- ~/Library/Logs, never /tmp — see the liveness plist above for why: macOS
       sweeps untouched /tmp files after 3+ days and launchd opens stdio once at
       spawn, so a swept log becomes an unlinked inode nothing reports. Declared
       in dotfiles/scripts/log-rotate.sh. -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/hermes-triage.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/hermes-triage.err</string>
</dict>
</plist>
